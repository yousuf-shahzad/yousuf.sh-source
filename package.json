{
  "name": "yousuf.sh",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "content:build": "node scripts/content.mjs",
    "predev": "npm run content:build",
    "dev": "vite",
    "prebuild": "npm run content:build",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:build": "node --test tests/build/*.test.mjs",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "showcase": "node scripts/showcase.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^1.4.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
