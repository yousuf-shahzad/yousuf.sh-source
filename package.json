{
    "name": "yousuf.sh",
    "private": true,
    "type": "module",
    "version": "0.0.0",
    "scripts": {
        "dev": "concurrently \"npm run content:watch\" \"vite\"",
        "build": "npm run content && vite build && node scripts/prerender.mjs",
        "content": "node scripts/content.mjs",
        "content:watch": "node scripts/content.mjs --watch",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@react-three/fiber": "^8.17.10",
        "@vercel/analytics": "^1.4.1",
        "framer-motion": "^11.13.5",
        "gray-matter": "^4.0.3",
        "lenis": "^1.1.18",
        "lucide-react": "^0.468.0",
        "react": "^18.3.1",
        "react-animated-cursor": "^2.11.2",
        "react-dom": "^18.3.1",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.0.1",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "three": "^0.171.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.3",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.1.0",
        "eslint": "^9.13.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "globals": "^15.11.0",
        "postcss": "^8.4.49",
        "prettier": "^3.9.6",
        "prop-types": "^15.8.1",
